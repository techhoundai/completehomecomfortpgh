---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTABanner from "../components/CTABanner.astro";
import { siteConfig } from "../data/siteConfig";

const jsonLd = [
  {
    "@type": "Service",
    name: "Cooling Services",
    serviceType: "Cooling",
    description: "Complete Home Comfort provides expert cooling solutions in Pittsburgh including central air conditioning, ductless mini-split systems, and heat pump installations and repairs.",
    provider: { "@id": `${siteConfig.url}/#organization` },
    areaServed: { "@type": "City", name: "Pittsburgh", addressRegion: "PA" },
    url: `${siteConfig.url}/cooling/`,
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Cooling Services",
      itemListElement: [
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "Central Air Conditioning" } },
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "Ductless Air Conditioning" } },
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "Heat Pump Cooling" } },
      ],
    },
  },
];
---

<BaseLayout
  title="Cooling Services"
  description="Expert cooling services in Pittsburgh - central AC, ductless air conditioning, and heat pump installations. Call (412) 757-2301."
  jsonLd={jsonLd}
>
  <PageHero
    title="Cooling Services"
    subtitle="Stay cool and comfortable all summer long"
    bgClass="bg2"
  />

  <section class="py-16 md:py-20">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8 fade-in">
      <p>Pittsburgh's summers bring hot temperatures and high humidity, making a dependable cooling system essential for your home's comfort. At Complete Home Comfort, we provide energy-efficient cooling solutions designed to keep every room in your home comfortable without driving up your utility bills.</p>
      <p>From central air conditioning installations to ductless mini-split systems and heat pumps, our team has the training and experience to recommend the right equipment for your home. We take the time to assess your space, discuss your priorities, and deliver a cooling solution that fits your needs and your budget.</p>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-surface">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-12 fade-in">
        <span class="inline-block text-chc-blue font-semibold text-[0.85rem] uppercase tracking-wider mb-2">Our Cooling Solutions</span>
        <h2>Comprehensive Cooling Services</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 fade-in">
        <ServiceCard icon="fas fa-snowflake" iconColor="blue" title="Central Air Conditioning" description="Central AC remains the most popular choice for whole-home cooling in the Pittsburgh area. Today's systems offer quiet operation, precise temperature control, and significantly improved energy efficiency compared to older units. We install, repair, and maintain central air conditioning systems from leading manufacturers to keep your entire home comfortable." link={{ text: "Schedule Service", href: "/contact/" }} />
        <ServiceCard icon="fas fa-wind" iconColor="blue" title="Ductless Air Conditioning" description="Ductless mini-split systems deliver powerful cooling without the need for traditional ductwork. These versatile units are an excellent choice for home additions, finished basements, sunrooms, and older homes without existing duct systems. With individual zone control, you can cool specific rooms as needed, reducing energy waste." link={{ text: "Schedule Service", href: "/contact/" }} />
        <ServiceCard icon="fas fa-temperature-arrow-down" iconColor="blue" title="Heat Pumps" description="Heat pumps provide both cooling and heating in a single system, making them one of the most energy-efficient options available. During the summer, a heat pump works just like an air conditioner, removing heat from your home. In the winter, it reverses the process to provide warmth. This dual functionality can simplify your HVAC setup and lower your year-round energy costs." link={{ text: "Schedule Service", href: "/contact/" }} />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-12 fade-in">
        <span class="inline-block text-chc-blue font-semibold text-[0.85rem] uppercase tracking-wider mb-2">What We Offer</span>
        <h2>Complete Cooling Care</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 fade-in">
        <ServiceCard icon="fas fa-wrench" iconColor="blue" title="AC Repair" description="When your air conditioner breaks down on a hot day, you need fast, reliable service. Our technicians provide thorough diagnostics to identify the root cause of the problem and get your system running again as quickly as possible. We service all major brands and models." listItems={["Fast response and accurate diagnostics", "All major brands and models serviced", "Upfront pricing before work begins", "Quality replacement parts"]} />
        <ServiceCard icon="fas fa-clipboard-check" iconColor="blue" title="AC Maintenance" description="Regular maintenance is the best way to extend the life of your cooling system, prevent unexpected breakdowns, and maintain peak efficiency. Our annual tune-up service includes a comprehensive inspection, cleaning, and adjustment of all key components." listItems={["Annual tune-ups and seasonal inspections", "Coil cleaning and refrigerant level checks", "Electrical connection and thermostat testing", "Extends equipment lifespan and prevents costly repairs"]} />
        <ServiceCard icon="fas fa-plus-circle" iconColor="blue" title="AC Installation" description="Proper sizing and installation are critical to the performance and longevity of your cooling system. Our team performs a detailed load calculation to determine the right equipment size for your home, then handles every step of the installation process with precision and care." listItems={["Expert sizing with Manual J load calculations", "Professional installation by trained technicians", "Energy-efficient models from trusted manufacturers", "Flexible financing options available"]} />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-surface">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8 fade-in">
      <div class="max-w-[800px] mx-auto text-center">
        <h2>Proud Armstrong Air Dealer</h2>
        <p>As an authorized Armstrong Air dealer, Complete Home Comfort offers a full line of dependable, high-efficiency cooling equipment backed by one of the most trusted names in the industry. Armstrong Air has been manufacturing quality HVAC systems since 1928, building a reputation for durable construction, quiet operation, and energy-saving performance.</p>
        <p>When you choose an Armstrong Air cooling system, you benefit from advanced engineering, strong warranty protection, and the confidence that comes from nearly a century of manufacturing excellence. Combined with our professional installation and service, an Armstrong Air system is an investment in long-term home comfort.</p>
        <a href="https://www.armstrongair.com/" target="_blank" rel="noopener noreferrer" class="btn btn-outline mt-4">Learn More About Armstrong Air</a>
      </div>
    </div>
  </section>

  <CTABanner
    title="Beat the Pittsburgh Heat"
    description="From new installations to emergency repairs and seasonal maintenance, our team is ready to help you stay cool and comfortable all summer long."
  />
</BaseLayout>
