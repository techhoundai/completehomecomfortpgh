---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CTABanner from "../components/CTABanner.astro";
import { siteConfig } from "../data/siteConfig";
import reviewsData from "../data/reviews.json";

const reviews = reviewsData.reviews || [];
const count = reviews.length.toString();

const jsonLd = [
  {
    "@type": "HVACBusiness",
    "@id": `${siteConfig.url}/#organization`,
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: "5.0",
      bestRating: "5",
      worstRating: "1",
      ratingCount: count,
      reviewCount: count,
    },
    review: reviews.map((r: any) => ({
      "@type": "Review",
      author: { "@type": "Person", name: r.authorName },
      reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" },
      reviewBody: r.text,
    })),
  },
];
---

<BaseLayout
  title="Reviews & Testimonials"
  description="Read 5-star Google reviews from Pittsburgh homeowners. See why they trust Complete Home Comfort for HVAC installations, repairs, and maintenance."
  jsonLd={jsonLd}
>
  <PageHero
    title="Reviews & Testimonials"
    subtitle="See what Pittsburgh homeowners are saying about our work"
    bgClass="bg2"
  />

  <!-- Reviews highlight -->
  <section class="py-16 md:py-20">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="flex flex-col items-center gap-6 text-center fade-in">
        <div class="flex gap-1 text-[#FFC107] text-2xl">
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
        </div>
        <p class="text-xl font-semibold text-heading">
          <a href={siteConfig.googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="text-inherit no-underline hover:underline">
            <span class="text-chc-blue">5-Star Reviews</span> from Google
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Reviews grid -->
  <section class="py-16 md:py-20 bg-surface">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-12 fade-in">
        <h2>What Our Customers Say</h2>
        <p class="text-muted text-lg max-w-[600px] mx-auto">Real reviews from Pittsburgh homeowners who trust Complete Home Comfort with their HVAC needs.</p>
      </div>
      <div class="columns-1 md:columns-2 gap-6">
        {reviews.map((review: any) => (
          <div class="fade-in">
            <TestimonialCard review={review} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Review platforms -->
  <section class="py-16 md:py-20">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-12 fade-in">
        <h2>Find Us on These Platforms</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 fade-in">
        <div class="bg-white border border-card-border rounded-2xl p-10 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-card">
          <i class="fab fa-instagram text-5xl mb-4 text-[#E1306C]"></i>
          <h3 class="mb-2">Instagram</h3>
          <p class="text-muted">Follow us on Instagram for project photos, updates, and behind-the-scenes content.</p>
          <a href={siteConfig.socials.instagram} class="btn btn-outline" target="_blank" rel="noopener noreferrer">View on Instagram</a>
        </div>
        <div class="bg-white border border-card-border rounded-2xl p-10 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-card">
          <i class="fab fa-yelp text-5xl mb-4 text-[#D32323]"></i>
          <h3 class="mb-2">Yelp</h3>
          <p class="text-muted">Find us on Yelp for reviews and more information about our services.</p>
          <a href={siteConfig.socials.yelp} class="btn btn-outline" target="_blank" rel="noopener noreferrer">View on Yelp</a>
        </div>
        <div class="bg-white border border-card-border rounded-2xl p-10 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-card">
          <i class="fab fa-facebook-f text-5xl mb-4 text-[#1877F2]"></i>
          <h3 class="mb-2">Facebook</h3>
          <p class="text-muted">Follow us on Facebook for updates, promotions, and customer feedback.</p>
          <a href={siteConfig.socials.facebook} class="btn btn-outline" target="_blank" rel="noopener noreferrer">View on Facebook</a>
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
