---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import Lightbox from "../components/Lightbox.astro";
import CTABanner from "../components/CTABanner.astro";
import { siteConfig } from "../data/siteConfig";

const jsonLd = [
  {
    "@type": "Service",
    name: "Heating Services",
    serviceType: "Heating",
    description: "Stay warm all winter with our expert heating services. We install, repair, and maintain furnaces, heat pumps, and boilers to keep your home comfortable.",
    provider: { "@id": `${siteConfig.url}/#organization` },
    areaServed: { "@type": "City", name: "Pittsburgh", addressRegion: "PA" },
    url: `${siteConfig.url}/heating/`,
  },
  {
    "@type": "Service",
    name: "Cooling Services",
    serviceType: "Cooling",
    description: "Beat the summer heat with reliable cooling solutions. We service central air conditioning, ductless mini-splits, and heat pump systems.",
    provider: { "@id": `${siteConfig.url}/#organization` },
    areaServed: { "@type": "City", name: "Pittsburgh", addressRegion: "PA" },
    url: `${siteConfig.url}/cooling/`,
  },
  {
    "@type": "Service",
    name: "Repair & Maintenance",
    serviceType: "HVAC Repair and Maintenance",
    description: "Keep your HVAC system running at peak performance with our thorough diagnostics, seasonal tune-ups, and emergency repair services.",
    provider: { "@id": `${siteConfig.url}/#organization` },
    areaServed: { "@type": "City", name: "Pittsburgh", addressRegion: "PA" },
    url: `${siteConfig.url}/services/`,
  },
];
---

<BaseLayout
  title="Pittsburgh HVAC Heating & Cooling Services"
  description="Complete Home Comfort LLC provides expert HVAC heating and cooling services in Pittsburgh, PA. Installation, repair, and maintenance. Call (412) 757-2301."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative bg-header-deep bg-[url('/media/background.webp')] bg-center bg-cover bg-no-repeat text-white pt-12 pb-32 md:pt-20 md:pb-16 overflow-hidden min-h-[60vh] flex items-start">
    <div class="absolute inset-0 bg-gradient-to-b from-[rgba(15,26,42,0.9)] via-[rgba(15,26,42,0.7)] to-[rgba(15,26,42,0.5)] pointer-events-none"></div>
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="relative z-[1] text-center max-w-[800px] mx-auto fade-in">
        <div class="inline-block bg-chc-blue/15 border border-chc-blue/30 text-chc-blue-light px-5 py-1.5 rounded-full text-[0.85rem] font-semibold uppercase tracking-wider mb-6">
          Pittsburgh's Trusted HVAC Experts
        </div>
        <h1 class="text-white mb-4 text-[clamp(2.2rem,6vw,3.5rem)]">
          Your Comfort Is <span class="block bg-gradient-to-br from-chc-red to-chc-blue bg-clip-text text-transparent">Our Mission</span>
        </h1>
        <p class="text-[clamp(1rem,2.5vw,1.2rem)] text-[#BDBDBD] mb-8 max-w-[600px] mx-auto">
          From expert installations to reliable repairs and preventive maintenance, Complete Home Comfort delivers quality HVAC service you can count on throughout the Pittsburgh area.
        </p>
        <div class="flex flex-col gap-4 items-center">
          <a href={siteConfig.svcFinanceUrl} class="btn btn-secondary btn-lg" target="_blank" rel="noopener noreferrer">Apply for Financing</a>
        </div>
        <div class="text-xl text-[#BDBDBD] mt-6">
          <a href={`tel:${siteConfig.phoneRaw}`} class="text-white font-bold text-[1.4rem] hover:text-chc-blue-light transition-colors">
            <i class="fas fa-phone"></i> {siteConfig.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 md:py-20 bg-surface">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-12 fade-in">
        <span class="inline-block text-chc-blue font-semibold text-[0.85rem] uppercase tracking-wider mb-2">What We Do</span>
        <h2>Our HVAC Services</h2>
        <p class="text-muted text-lg max-w-[600px] mx-auto">Comprehensive heating and cooling solutions for homes throughout Pittsburgh and the surrounding area.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 fade-in">
        <ServiceCard icon="fas fa-fire" iconColor="red" title="Heating" description="Stay warm all winter with our expert heating services. We install, repair, and maintain furnaces, heat pumps, and boilers to keep your home comfortable." link={{ text: "Learn More", href: "/heating/" }} />
        <ServiceCard icon="fas fa-snowflake" iconColor="blue" title="Cooling" description="Beat the summer heat with reliable cooling solutions. We service central air conditioning, ductless mini-splits, and heat pump systems." link={{ text: "Learn More", href: "/cooling/" }} />
        <ServiceCard icon="fas fa-wrench" iconColor="gray" title="Repair & Maintenance" description="Keep your HVAC system running at peak performance with our thorough diagnostics, seasonal tune-ups, and emergency repair services." link={{ text: "Learn More", href: "/services/" }} />
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 md:py-20">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-12 fade-in">
        <span class="inline-block text-chc-blue font-semibold text-[0.85rem] uppercase tracking-wider mb-2">Why Choose Us</span>
        <h2>Quality Service You Can Trust</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 justify-items-center fade-in">
        {[
          { icon: "fas fa-shield-halved", title: "Licensed & Insured", text: "Fully licensed (PA HIC #PA164565) and insured for your peace of mind on every job." },
          { icon: "fas fa-award", title: "Quality Workmanship", text: "We take pride in every installation and repair, using top-quality equipment and proven techniques." },
          { icon: "fas fa-handshake", title: "Honest Pricing", text: "Transparent, upfront pricing with no hidden fees or surprise charges. You know what you pay before work begins." },
          { icon: "fas fa-star", title: "Satisfaction Guaranteed", text: "Your comfort is our priority. We stand behind our work and ensure you are completely satisfied." },
        ].map((feature) => (
          <div class="text-center p-6">
            <div class="w-[70px] h-[70px] rounded-full flex items-center justify-center text-[1.6rem] mx-auto mb-4 bg-gradient-to-br from-chc-blue to-chc-red text-white">
              <i class={feature.icon}></i>
            </div>
            <h4 class="mb-2">{feature.title}</h4>
            <p class="text-muted text-sm">{feature.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Projects -->
  <section class="py-16 md:py-20 bg-surface">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-12 fade-in">
        <span class="inline-block text-chc-blue font-semibold text-[0.85rem] uppercase tracking-wider mb-2">Our Work</span>
        <h2>Recent Projects</h2>
      </div>
      <GalleryGrid limit={6} />
      <div class="text-center mt-8">
        <a href="/gallery/" class="btn btn-primary">View All Projects</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-16 md:py-20">
    <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-12 fade-in">
        <span class="inline-block text-chc-blue font-semibold text-[0.85rem] uppercase tracking-wider mb-2">Testimonials</span>
        <h2>What Our Customers Say</h2>
      </div>
      <div class="flex flex-col items-center gap-6 text-center fade-in">
        <div class="flex gap-1 text-[#FFC107] text-2xl">
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
        </div>
        <p class="text-xl font-semibold text-heading">
          <a href={siteConfig.googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="text-inherit no-underline hover:underline">
            <span class="text-chc-blue">5-Star Reviews</span> from Google
          </a>
        </p>
        <a href="/testimonials/" class="btn btn-primary">Read Our Reviews</a>
      </div>
      <div class="flex flex-wrap justify-center gap-8 items-center mt-8 fade-in">
        {[
          { icon: "fas fa-shield-halved", label: "Licensed & Insured" },
          { icon: "fas fa-certificate", label: "Armstrong Air Dealer" },
          { icon: "fas fa-map-marker-alt", label: "Pittsburgh Local" },
          { icon: "fas fa-thumbs-up", label: "Satisfaction Guaranteed" },
        ].map((badge) => (
          <div class="flex flex-col items-center gap-2 text-center">
            <i class={`${badge.icon} text-chc-blue text-2xl`}></i>
            <span class="text-[0.8rem] font-semibold text-muted">{badge.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
  <Lightbox />
</BaseLayout>
