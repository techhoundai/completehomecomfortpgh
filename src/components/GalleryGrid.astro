---
import GalleryItem from "./GalleryItem.astro";
import galleryData from "../data/gallery.json";

interface Props {
  limit?: number;
  fullWidth?: boolean;
}

const { limit, fullWidth = false } = Astro.props;
const items = limit ? galleryData.images.slice(0, limit) : galleryData.images;
---

<div class:list={[
  "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4",
  fullWidth && "xl:grid-cols-4",
]}>
  {items.map((item) => (
    <div class="fade-in">
      <GalleryItem item={item} />
    </div>
  ))}
</div>
