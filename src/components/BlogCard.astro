---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  readingTime?: string;
  headingLevel?: "h2" | "h3";
}

const { title, description, date, slug, tags, readingTime, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a href={`/blog/${slug}/`} class="bg-white border border-card-border rounded-xl overflow-hidden group block hover:shadow-card hover:-translate-y-1 transition-all duration-300">
  <div class="p-8">
    <div class="flex items-center gap-3 text-xs text-muted mb-3">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {readingTime && <span>&middot; {readingTime}</span>}
    </div>
    <Heading class="text-lg font-heading font-semibold mb-3 group-hover:text-chc-blue transition-colors">
      {title}
    </Heading>
    <p class="text-body text-sm leading-relaxed mb-4">{description}</p>
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="text-xs px-2 py-1 rounded-full bg-chc-blue/10 text-chc-blue font-medium">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
