---
import { siteConfig } from "../data/siteConfig";
---

<form id="contact-form">
  <input type="hidden" name="access_key" value={siteConfig.web3formsKey} />
  <input type="hidden" name="subject" value="New Contact Form Submission - Complete Home Comfort" />
  <input type="hidden" name="from_name" value="Complete Home Comfort Website" />

  <div class="mb-5">
    <label for="name" class="block font-semibold mb-1.5 text-heading text-sm">Full Name</label>
    <input type="text" name="name" id="name" required
      class="w-full py-3.5 px-4 bg-white border-2 border-input-border rounded-lg text-base font-[inherit] text-heading min-h-[44px] transition-all focus:outline-none focus:border-chc-blue focus:ring-[3px] focus:ring-chc-blue/15" />
  </div>

  <div class="mb-5">
    <label for="email" class="block font-semibold mb-1.5 text-heading text-sm">Email</label>
    <input type="email" name="email" id="email" required
      class="w-full py-3.5 px-4 bg-white border-2 border-input-border rounded-lg text-base font-[inherit] text-heading min-h-[44px] transition-all focus:outline-none focus:border-chc-blue focus:ring-[3px] focus:ring-chc-blue/15" />
  </div>

  <div class="mb-5">
    <label for="phone" class="block font-semibold mb-1.5 text-heading text-sm">Phone Number</label>
    <input type="tel" name="phone" id="phone"
      class="w-full py-3.5 px-4 bg-white border-2 border-input-border rounded-lg text-base font-[inherit] text-heading min-h-[44px] transition-all focus:outline-none focus:border-chc-blue focus:ring-[3px] focus:ring-chc-blue/15" />
  </div>

  <div class="mb-5">
    <label for="service" class="block font-semibold mb-1.5 text-heading text-sm">Service Needed</label>
    <select name="service" id="service"
      class="w-full py-3.5 px-4 bg-white border-2 border-input-border rounded-lg text-base font-[inherit] text-heading min-h-[44px] transition-all focus:outline-none focus:border-chc-blue focus:ring-[3px] focus:ring-chc-blue/15">
      <option value="">Select a service</option>
      <option value="Heating Installation">Heating Installation</option>
      <option value="Cooling Installation">Cooling Installation</option>
      <option value="HVAC Repair">HVAC Repair</option>
      <option value="Maintenance">Maintenance</option>
      <option value="Ductless Mini-Split">Ductless Mini-Split</option>
      <option value="Water Heater">Water Heater</option>
      <option value="Free Estimate">Free Estimate</option>
      <option value="Other">Other</option>
    </select>
  </div>

  <div class="mb-5">
    <label for="message" class="block font-semibold mb-1.5 text-heading text-sm">Message</label>
    <textarea name="message" id="message" rows="5" required
      class="w-full py-3.5 px-4 bg-white border-2 border-input-border rounded-lg text-base font-[inherit] text-heading min-h-[120px] resize-y transition-all focus:outline-none focus:border-chc-blue focus:ring-[3px] focus:ring-chc-blue/15"></textarea>
  </div>

  <button type="submit" class="btn btn-primary w-full">Send Message</button>
  <div id="form-status" class="mt-4 p-4 rounded-lg font-medium hidden"></div>
</form>

<script>
  const contactForm = document.getElementById("contact-form") as HTMLFormElement | null;
  if (contactForm) {
    contactForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      const status = document.getElementById("form-status") as HTMLDivElement;
      const originalText = btn.textContent;

      btn.textContent = "Sending...";
      btn.disabled = true;

      try {
        const formData = new FormData(contactForm);
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });
        const data = await response.json();

        if (data.success) {
          status.textContent = "Thank you! Your message has been sent. We'll get back to you shortly.";
          status.className = "mt-4 p-4 rounded-lg font-medium block bg-green-500/10 text-green-800 border border-green-500/30";
          contactForm.reset();
        } else {
          throw new Error(data.message || "Something went wrong");
        }
      } catch {
        status.textContent = "Oops! Something went wrong. Please call us at (412) 757-2301.";
        status.className = "mt-4 p-4 rounded-lg font-medium block bg-chc-red/10 text-chc-red border border-chc-red/30";
      }

      btn.textContent = originalText;
      btn.disabled = false;
    });
  }
</script>
