---
import { siteConfig } from "../data/siteConfig";

interface Props {
  title?: string;
  description?: string;
  showFinancing?: boolean;
}

const {
  title = "Ready for Total Home Comfort?",
  description = "Whether you need a new installation, emergency repair, or routine maintenance, our team is ready to serve homeowners throughout the Pittsburgh area.",
  showFinancing = true,
} = Astro.props;
---

<section class="bg-gradient-to-br from-chc-red to-chc-red-dark text-white py-14 text-center">
  <div class="w-full max-w-container mx-auto px-4 md:px-8 fade-in">
    <h2 class="text-white mb-4">{title}</h2>
    <p class="text-white/85 text-lg mb-8">{description}</p>
    <div class="flex flex-col md:flex-row gap-4 items-center justify-center">
      {showFinancing && (
        <a href={siteConfig.svcFinanceUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          Apply for Financing
        </a>
      )}
      <a href={`tel:${siteConfig.phoneRaw}`} class="btn btn-secondary cta-secondary">
        Call {siteConfig.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-secondary:hover {
    background: #ffffff;
    color: #E53935;
    border-color: #ffffff;
  }
</style>
