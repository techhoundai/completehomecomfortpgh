---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTABanner from "../components/CTABanner.astro";
import { siteConfig } from "../data/siteConfig";

interface Props {
  title: string;
  description: string;
  date: Date;
  dateModified?: Date;
  author: string;
  tags?: string[];
  faq?: Array<{ question: string; answer: string }>;
  readingTime?: number;
  wordCount?: number;
}

const { title, description, date, dateModified, author, tags, faq, readingTime, wordCount } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url).href;

const blogPostingJsonLd = {
  "@type": "BlogPosting",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (dateModified ?? date).toISOString(),
  ...(wordCount ? { wordCount } : {}),
  articleSection: tags?.[0],
  author: {
    "@type": "Organization",
    "@id": `${siteConfig.url}/#organization`,
  },
  publisher: { "@id": `${siteConfig.url}/#organization` },
};

const articleMeta = {
  publishedTime: date.toISOString(),
  tags,
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  article={articleMeta}
  jsonLd={[blogPostingJsonLd]}
>
  <PageHero title={title} subtitle="HVAC Tips & Insights" bgClass="bg2" />

  <article class="py-16 md:py-20">
    <div class="w-full max-w-3xl mx-auto px-4 md:px-8">
      <header class="mb-10">
        <div class="flex items-center gap-3 text-sm text-muted mb-4">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          <span>by {author}</span>
          {readingTime && <span>&middot; {readingTime} min read</span>}
        </div>
        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="text-xs px-2 py-1 rounded-full bg-chc-blue/10 text-chc-blue font-medium">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <div class="prose prose-lg max-w-none
        prose-headings:font-heading prose-headings:font-semibold prose-headings:text-heading
        prose-a:text-chc-blue prose-a:no-underline hover:prose-a:underline
        prose-p:leading-relaxed prose-p:text-body
        prose-li:text-body
        prose-strong:text-heading
        prose-blockquote:border-chc-blue
        prose-code:text-chc-red
        prose-img:rounded-xl
      ">
        <slot />
      </div>
    </div>
  </article>

  {faq && faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    })} />
  )}

  <CTABanner
    title="Need Help With Your HVAC System?"
    description="Whether it is time for a replacement or you just need a tune-up, our team is here to help Pittsburgh homeowners stay comfortable year-round."
  />
</BaseLayout>
